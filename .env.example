OPENAI_API_KEY=
# Official model IDs checked 2026-09-21; verify account access with `make preflight`.
OPENAI_AGENT_MODEL=gpt-5.6-terra
OPENAI_AGENT_REASONING_EFFORT=low
OPENAI_ENRICH_MODEL=gpt-5.6-terra
OPENAI_ENRICH_REASONING_EFFORT=low
OPENAI_JUDGE_MODEL=gpt-6-astra
OPENAI_JUDGE_REASONING_EFFORT=medium
# Must support both image generation and image edits for photo-based virtual try-on.
OPENAI_IMAGE_MODEL=gpt-image-2.5-flare
OPENAI_IMAGE_QUALITY=medium
OPENAI_MODERATION_MODEL=omni-moderation-latest
MODERATION_POLICY_VERSION=v1
MODERATION_TIMEOUT_SECONDS=5
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
DEMO_MODE=live
DEMO_SEASON=fall
DEMO_AUDIT_ENABLED=true
# Shared UTC-day limit for runtime color/outfit/sample image calls; 0 disables new calls.
# Cached images remain available. Failed/uncertain provider calls consume a reservation.
DAILY_IMAGE_CALL_LIMIT=100
DATABASE_PATH=./data/runtime/catalog.sqlite
INDEX_DIR=./data/runtime/index
IMAGE_DIR=./data/runtime/images
ALLOWED_ORIGIN=http://localhost:3000
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api
